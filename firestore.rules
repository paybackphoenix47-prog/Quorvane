rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data, uid) {
      return data.id == uid &&
        data.email is string && data.email.size() <= 200 &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 60 &&
        (data.role == 'trainee' || data.role == 'analyst' || data.role == 'operator' || data.role == 'admin') &&
        data.xp is number && data.xp >= 0 &&
        data.level is number && data.level >= 1 &&
        data.completedLabs is list && data.completedLabs.size() <= 100 &&
        data.completedModules is list && data.completedModules.size() <= 100 &&
        data.completedStages is list && data.completedStages.size() <= 50 &&
        data.achievements is list && data.achievements.size() <= 50;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);

      match /labAttempts/{attemptId} {
        allow read, write: if isOwner(userId) && isValidId(attemptId);
      }

      match /activities/{activityId} {
        allow read, write: if isOwner(userId) && isValidId(activityId);
      }
    }
  }
}
